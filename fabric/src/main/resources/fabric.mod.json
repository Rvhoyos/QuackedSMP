{
  "schemaVersion": 1,
  "id": "quacksmp",
  "version": "${version}",
  "name": "QuackSMP",
  "description": "Server-side mod with a built-in browser admin panel. Every feature is modular, enable only what you want. Includes claims, RPG skills, custom dimensions, chat filter, Discord, Votifier, and more. No config editing required.",
  "authors": [
    "Monte_Carlo_Simulations"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/quackedsmp",
    "sources": "https://github.com/Rvhoyos/QuackedSMP",
    "issues": "https://github.com/Rvhoyos/QuackedSMP/issues"
  },
  "license": "ARR",
  "icon": "assets/quacksmp/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "mc.smpessentials.fabric.SmpUtilsModFabric"
    ],
    "voicechat:plugin": [
      "mc.smpessentials.voicechat.QuackedVoicechatPlugin"
    ]
  },
  "mixins": [
    "quacksmp.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.17.3",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "another-mod": "*"
  }
}